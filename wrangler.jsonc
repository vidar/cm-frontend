{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"compatibility_date": "2026-10-01",
	"compatibility_flags": ["global_fetch_strictly_public", "nodejs_compat"],
	"name": "cm-frontend",
	"main": "@astrojs/cloudflare/entrypoints/server",
	"workers_dev": false,
	"preview_urls": true,
	"routes": [{ "pattern": "chessmoments.com", "custom_domain": true }],
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS"
	},
	// TWIC games database: Neon Postgres (read-only role) through Hyperdrive. `localConnectionString`
	// is only used by `astro dev` / `wrangler dev`; point it at a local copy if you need one.
	"hyperdrive": [{ "binding": "HYPERDRIVE", "id": "ff39804dfb964a2ca13a9e1d7ec27cbe", "localConnectionString": "postgres://postgres:postgres@localhost:5432/cm_games" }],
	"previews": {
		// Bindings aren't inherited by previews; they read the same games database.
		"hyperdrive": [{ "binding": "HYPERDRIVE", "id": "ff39804dfb964a2ca13a9e1d7ec27cbe", "localConnectionString": "postgres://postgres:postgres@localhost:5432/cm_games" }]
	},
	"observability": {
		"enabled": true
	}
}