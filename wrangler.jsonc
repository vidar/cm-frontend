{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"compatibility_date": "2026-10-01",
	"compatibility_flags": ["global_fetch_strictly_public"],
	"name": "cm-frontend",
	"main": "@astrojs/cloudflare/entrypoints/server",
	"workers_dev": false,
	"preview_urls": true,
	"routes": [{ "pattern": "chessmoments.com", "custom_domain": true }],
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS"
	},
	"d1_databases": [{ "binding": "DB", "database_name": "cm-games", "database_id": "8a8b6bce-cafd-4569-8ea3-58a08dc291f3" }],
	"previews": {
		// Bindings aren't inherited by previews; they read the same (read-only use) games database.
		"d1_databases": [{ "binding": "DB", "database_name": "cm-games", "database_id": "8a8b6bce-cafd-4569-8ea3-58a08dc291f3" }]
	},
	"observability": {
		"enabled": true
	}
}