# Settings for cm-db-backup (installed as /etc/cm-db/backup.env, root only). Optional; defaults in backup.sh.
#
# Group allowed to read the dumps (for a pull from the Mac mini as that user), e.g. BACKUP_GROUP=vidar.
# Empty: root only.
BACKUP_GROUP=
# Off-site copy with rclone (apt install rclone), to a remote set up in /etc/cm-db/rclone.conf, e.g.
# RCLONE_REMOTE=r2:cm-db-backups . Empty: no off-site copy from this box.
RCLONE_REMOTE=
# Dead-man's switch: a healthchecks.io (or similar) ping URL for cm-db-check. Empty: journal only.
HC_URL=
