# Settings for cm-db-backup (installed as /etc/cm-db/backup.env, root only). Optional; defaults in backup.sh.
#
# Group allowed to read the dumps (for a pull from the Mac mini as that user), e.g. BACKUP_GROUP=vidar.
# Empty: root only.
BACKUP_GROUP=
# Off-site copy with rclone (apt install rclone), to a remote set up in /etc/cm-db/rclone.conf, e.g.
# RCLONE_REMOTE=r2:cm-db-backups . The remote keeps what this box keeps (daily/, small/ for 7.5 days,
# weekly/ for 36): the token needs Object Read & Write. Empty: no off-site copy from this box.
# With both BACKUP_GROUP and RCLONE_REMOTE empty, cm-db-check reports "no off-site copy configured".
RCLONE_REMOTE=
# Dead-man's switch: a healthchecks.io (or similar) ping URL for cm-db-check. Empty: journal only.
HC_URL=
# The site's own way to the database (Worker -> Hyperdrive -> tunnel -> Postgres), checked by cm-db-check.
# Set it once the site reads this database (README step 10): SITE_CHECK_URL=https://chessmoments.com/health/db
SITE_CHECK_URL=
# A maintenance (MAINTENANCE "1") seen there for longer than this many hours is a problem. Default 6.
MAINTENANCE_MAX_HOURS=
# The engine as the Worker reaches it (answer and certificate), checked by cm-db-check (README step 10):
# ENGINE_CHECK_URL=https://engine.chessmoments.com/healthz . Empty: not checked.
ENGINE_CHECK_URL=
# A TWIC build (meta built_at) older than this many days is a problem: the import is behind. Default 9; 0: off.
IMPORT_MAX_DAYS=
