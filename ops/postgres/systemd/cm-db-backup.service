[Unit]
Description=Nightly full backup of the chessmoments.com database
# After, not Requires: a backup must never start a database that was stopped on purpose.
After=postgresql.service

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/cm-db-backup full
Nice=10
IOSchedulingClass=idle
CPUWeight=20
PrivateTmp=true
ProtectHome=true
NoNewPrivileges=true
