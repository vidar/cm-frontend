[Unit]
Description=Backup of the chessmoments.com tables that can't be rebuilt (analyses, AI notes, uploads)
After=postgresql.service
Requires=postgresql.service

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/cm-db-backup small
Nice=10
IOSchedulingClass=idle
CPUWeight=20
PrivateTmp=true
ProtectHome=true
NoNewPrivileges=true
