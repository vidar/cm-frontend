---
import BoardStyle from '../../components/BoardStyle.astro';
import { Chess } from 'chess.js';
import Layout from '../../layouts/Layout.astro';
import BoardDiagram from '../../components/BoardDiagram.astro';
import GameTable from '../../components/GameTable.astro';
import '../../styles/board.css';
import { parseRound } from '../../lib/event';
import { getGame, getOpeningName, gamePath, headToHead, resultLabel, twicIssueUrl } from '../../lib/games';

export const prerender = false;

const id = Number.parseInt(Astro.params.game ?? '', 10);
const game = Number.isFinite(id) ? await getGame(id) : null;
if (!game) return new Response('Game not found', { status: 404, headers: { 'Content-Type': 'text/plain' } });
const canonical = gamePath(game);
if (Astro.url.pathname !== canonical) return Astro.redirect(canonical, 301);
Astro.response.headers.set('Cache-Control', 'public, max-age=86400');

const sans = game.moves.split(' ').filter(Boolean);
const chess = new Chess();
let last: [string, string] | undefined;
for (const san of sans) {
  const m = chess.move(san);
  last = [m.from, m.to];
}
const finalFen = chess.fen();
const [openingName, h2h] = await Promise.all([game.opening ? getOpeningName(game.opening) : null, headToHead(game.white_id, game.black_id, 21)]);
const opening = openingName ? { name: openingName } : null;
const others = h2h.filter((g) => g.id !== game.id).slice(0, 20);

const roundN = parseRound(game.round).n;
const who = (name: string, title: string | null) => `${title ? `${title} ` : ''}${name}`;
const year = game.date?.slice(0, 4);
const title = `${game.white_name} vs ${game.black_name}, ${game.event_name}${year && !game.event_name.includes(year) ? ` ${year}` : ''}`;
const movesText = sans.map((m, i) => (i % 2 === 0 ? `${i / 2 + 1}. ${m}` : m)).join(' ');
const pgn = [
  `[Event "${game.event_name}"]`,
  game.event_site ? `[Site "${game.event_site}"]` : null,
  `[Date "${(game.date ?? '????').replace(/-/g, '.')}"]`,
  game.round ? `[Round "${game.round}"]` : null,
  `[White "${game.white_name}"]`,
  `[Black "${game.black_name}"]`,
  `[Result "${game.result}"]`,
  game.white_elo ? `[WhiteElo "${game.white_elo}"]` : null,
  game.black_elo ? `[BlackElo "${game.black_elo}"]` : null,
  game.eco ? `[ECO "${game.eco}"]` : null,
  `[Source "The Week in Chess ${game.twic}"]`,
  '',
  `${movesText} ${game.result}`,
]
  .filter((l) => l !== null)
  .join('\n');
---

<Layout
  og={{ fen: finalFen, lastMove: last, kicker: game.event_name, title: `${game.white_name} vs ${game.black_name}`, subtitle: [game.round && `Round ${game.round.split('.')[0]}`, game.event_site, game.date].filter(Boolean).join(' · '), footer: `${resultLabel(game.result)} · ${Math.ceil(game.plies / 2)} moves` }}
  title={title}
  description={`${title}: ${resultLabel(game.result)} in ${Math.ceil(game.plies / 2)} moves${opening ? `, ${opening.name}` : ''}. Replay the game move by move and analyse it with Stockfish.`}
  wide
>
  <nav class="crumbs">
    <a href="/games/">Games</a> › <a href={`/events/${game.event_slug}/`}>{game.event_name}</a>
    {roundN && <> › <a href={`/events/${game.event_slug}/round-${roundN}/`}>Round {roundN}</a></>}
  </nav>
  <h1>
    <a href={`/players/${game.white_slug}/`}>{who(game.white_name, game.white_title)}</a>{' vs '}<a
      href={`/players/${game.black_slug}/`}>{who(game.black_name, game.black_title)}</a>
  </h1>
  <p class="meta">
    <strong>{resultLabel(game.result)}</strong>{' · '}<a href={`/events/${game.event_slug}/`}>{game.event_name}</a>{game.round && `, round ${game.round}`}
    {game.event_site && ` · ${game.event_site}`}{game.date && ` · ${game.date}`}
    {(game.white_elo || game.black_elo) && ` · ratings ${game.white_elo ?? '–'} / ${game.black_elo ?? '–'}`}
  </p>
  {opening && (
    <p class="meta">Opening: <a href={`/openings/${game.opening}/`}>{opening.name}</a>{game.eco && ` (${game.eco})`}</p>
  )}

  <div class="viewer" data-moves={sans.join(' ')} data-flip="0">
    <div class="board-col">
      <div data-board class="board-wrap">
        <BoardDiagram fen={finalFen} highlight={last} title={`Final position of ${title}`} />
      </div>
      <div class="nav">
        <button type="button" data-nav="start" aria-label="Start">⏮</button>
        <button type="button" data-nav="prev" aria-label="Previous move">◀</button>
        <button type="button" data-nav="next" aria-label="Next move">▶</button>
        <button type="button" data-nav="end" aria-label="End">⏭</button>
        <button type="button" data-nav="flip">Flip</button>
      </div>
      <div class="board-style-row"><BoardStyle /></div>
    </div>
    <div class="side">
      <div class="moves" role="list">
        {Array.from({ length: Math.ceil(sans.length / 2) }, (_, i) => (
          <div class="row" role="listitem">
            <span class="num">{i + 1}.</span>
            <span class="mv" data-ply={2 * i + 1}>{sans[2 * i]}</span>
            {sans[2 * i + 1] ? <span class="mv" data-ply={2 * i + 2}>{sans[2 * i + 1]}</span> : <span></span>}
          </div>
        ))}
        <div class="row result">{game.result}</div>
      </div>
      <p class="actions">
        <a data-analyse href={`/analysis/?pgn=${encodeURIComponent(sans.join(' '))}`}><strong>Analyse this position with Stockfish</strong></a>
      </p>
      <details>
        <summary>PGN</summary>
        <pre class="pgn">{pgn}</pre>
      </details>
    </div>
  </div>

  <section class="engine" data-analysis={game.id} data-result={game.result} hidden aria-live="polite">
    <h2>Engine analysis</h2>
    <div data-part="none" hidden>
      <p>Stockfish hasn't analysed this game yet. It takes about a minute: every position is evaluated, and mistakes and the best moves are marked.</p>
      <button type="button" class="primary" data-queue>Analyse with Stockfish</button>
    </div>
    <div data-part="pending" hidden>
      <p data-progress>Queued, waiting for the engine…</p>
      <div class="bar"><span></span></div>
      <p class="muted small">You can leave this page: the analysis is saved for everyone when it's done.</p>
    </div>
    <div data-part="done" hidden>
      <p class="now" data-now></p>
      <p class="now-note" data-now-note hidden></p>
      <svg class="graph" viewBox="0 0 600 120" preserveAspectRatio="none" role="img" aria-label="Evaluation through the game: light area means White is better, dark means Black"></svg>
      <table class="summary">
        <thead><tr><th></th><th class="num" title="Average centipawn loss">Avg loss</th><th class="num">Inaccuracies <span class="g-t-inaccuracy">?!</span></th><th class="num">Mistakes <span class="g-t-mistake">?</span></th><th class="num">Blunders <span class="g-t-blunder">??</span></th></tr></thead>
        <tbody></tbody>
      </table>
      <p class="muted small">Stockfish 17.1, depth <span data-depth></span>. Click the graph to jump to a move.</p>
      <div class="ai" data-ai hidden>
        <h3>Notes</h3>
        <div data-ai-part="none" hidden>
          <p>Get a short story of the game and notes on the key moves, written by AI from this analysis.</p>
          <button type="button" class="primary" data-ai-write>Write notes with AI</button>
        </div>
        <div data-ai-part="running" hidden>
          <p class="writing">Writing notes… this takes about half a minute.</p>
        </div>
        <div data-ai-part="done" hidden>
          <div class="ai-summary" data-ai-summary></div>
          <p class="muted small">Written by <span data-ai-model></span> from the Stockfish analysis; notes appear under their moves. AI can get things wrong.</p>
        </div>
        <div data-ai-part="error" hidden>
          <p data-ai-message></p>
          <button type="button" data-ai-retry>Try again</button>
        </div>
      </div>
    </div>
    <div data-part="error" hidden>
      <p data-message></p>
      <button type="button" data-retry hidden>Try again</button>
    </div>
  </section>

  {others.length > 0 && (
    <section>
      <h2>Other games between {game.white_name} and {game.black_name}</h2>
      <GameTable games={others} showEvent />
    </section>
  )}

  <p class="credit">
    Game from <a href={twicIssueUrl(game.twic)} rel="nofollow">The Week in Chess #{game.twic}</a> by Mark Crowther, used with permission.
    Please support TWIC.
  </p>
</Layout>

<style>
  .crumbs { font-size: 0.9rem; color: var(--muted); }
  h1 { font-size: 1.6rem; }
  h1 a { color: inherit; }
  .meta { margin: 0.25rem 0; color: var(--muted); }
  .meta strong { color: var(--fg); }
  .viewer { display: grid; gap: 1.25rem; margin-top: 1rem; }
  @media (min-width: 60rem) { .viewer { grid-template-columns: minmax(0, 32rem) minmax(0, 1fr); align-items: start; } }
  .board-wrap :global(.cm-board) { width: 100%; }
  .nav { display: flex; gap: 0.35rem; margin-top: 0.5rem; }
  .nav button { flex: 1; font: inherit; padding: 0.3rem; cursor: pointer; }
  .moves { max-height: 26rem; overflow-y: auto; border: 1px solid color-mix(in srgb, currentColor 15%, transparent); border-radius: 6px; padding: 0.4rem 0.6rem; }
  .moves .row { display: grid; grid-template-columns: 2.5rem 5.5rem 5.5rem; align-items: center; }
  .moves .num { color: var(--muted); font-variant-numeric: tabular-nums; }
  .moves .result { display: block; font-weight: 600; padding: 0.2rem 0 0 2.5rem; }
  .mv { cursor: pointer; padding: 0 0.3rem; border-radius: 3px; justify-self: start; }
  .mv:hover { background: color-mix(in srgb, currentColor 10%, transparent); }
  .mv.current { background: var(--accent-fill); color: #fff; }
  .pgn { white-space: pre-wrap; font-size: 0.8rem; }
  .engine { margin-top: 1.5rem; background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius); padding: 0.8rem 1rem 1rem; }
  .engine h2 { margin-top: 0.2rem; }
  .engine .bar { height: 0.5rem; border-radius: 999px; background: var(--surface-2); overflow: hidden; }
  .engine .bar span { display: block; height: 100%; width: 0; background: var(--accent-fill); transition: width 0.4s; }
  .engine .now { font-weight: 500; min-height: 1.5em; }
  .engine .graph { width: 100%; height: 7.5rem; display: block; border-radius: 6px; cursor: pointer; border: 1px solid var(--border); }
  .engine :global(.g-black) { fill: #2a241d; }
  .engine :global(.g-white) { fill: #f4efe6; }
  .engine :global(.g-mid) { stroke: #9a8f80; stroke-dasharray: 3 3; stroke-width: 1; }
  .engine :global(.g-line) { fill: none; stroke: #b45309; stroke-width: 1.5; vector-effect: non-scaling-stroke; }
  .engine :global(.g-cursor) { stroke: var(--accent); stroke-width: 2; vector-effect: non-scaling-stroke; }
  .engine :global(.g-dot line) { stroke-linecap: round; vector-effect: non-scaling-stroke; }
  .engine :global(.g-ring) { stroke: #fff; stroke-width: 10; }
  .engine :global(.g-fill) { stroke-width: 8; }
  .engine :global(.g-blunder .g-fill) { stroke: var(--loss); }
  .engine :global(.g-mistake .g-fill) { stroke: #d97706; }
  .engine :global(.g-inaccuracy .g-fill) { stroke: #eab308; }
  .engine .summary { border-collapse: collapse; margin: 0.75rem 0 0.25rem; font-size: 0.9rem; font-variant-numeric: tabular-nums; }
  .engine .summary th, .engine .summary td { padding: 0.25rem 0.9rem 0.25rem 0; text-align: left; }
  .engine .summary .num { text-align: right; }
  .engine :global(.g-t-blunder) { color: var(--loss); font-weight: 700; }
  .engine :global(.g-t-mistake) { color: #c2640c; font-weight: 700; }
  .engine :global(.g-t-inaccuracy) { color: #a16207; font-weight: 700; }
  .moves :global(.ann) { font-weight: 700; margin-left: 0.1rem; }
  .moves :global(.ann-blunder .ann) { color: var(--loss); }
  .moves :global(.ann-mistake .ann) { color: #c2640c; }
  .moves :global(.ann-inaccuracy .ann) { color: #a16207; }
  .engine .now-note { margin: -0.4rem 0 0.6rem; font-size: 0.92rem; }
  .engine .ai { border-top: 1px solid var(--border); margin-top: 1rem; padding-top: 0.25rem; }
  .engine .ai h3 { margin: 0.6rem 0 0.4rem; font-size: 1.1rem; }
  .engine .ai-summary { max-width: 48rem; }
  @media (prefers-reduced-motion: no-preference) { .engine .writing { animation: pulse 1.6s ease-in-out infinite; } }
  @keyframes pulse { 50% { opacity: 0.45; } }
  .moves :global(.note) { font-size: 0.85rem; line-height: 1.4; color: var(--muted); padding: 0.15rem 0.3rem 0.35rem 2.5rem; cursor: pointer; border-radius: 3px; }
  .moves :global(.note b) { color: var(--fg); font-weight: 600; }
  .moves :global(.note:hover), .moves :global(.note.current) { background: var(--accent-soft); color: var(--fg); }
  .muted { color: var(--muted); }
  .small { font-size: 0.85rem; }
  .credit { margin-top: 2rem; font-size: 0.85rem; color: var(--muted); }
</style>

<script>
  import { mountGameViewer } from '../../scripts/game-viewer';
  import { mountGameAnalysis } from '../../scripts/game-analysis';
  const root = document.querySelector<HTMLElement>('.viewer');
  const panel = document.querySelector<HTMLElement>('[data-analysis]');
  if (root && panel) mountGameAnalysis(panel, root);
  if (root) mountGameViewer(root);
</script>
