---
import { START_FEN } from '../../../lib/og-url';
import Layout from '../../../layouts/Layout.astro';
import BoardDiagram from '../../../components/BoardDiagram.astro';
import Standings from '../../../components/event/Standings.astro';
import RoundGames from '../../../components/event/RoundGames.astro';
import TeamMatch from '../../../components/event/TeamMatch.astro';
import TeamStandings from '../../../components/event/TeamStandings.astro';
import Knockout from '../../../components/event/Knockout.astro';
import '../../../styles/event.css';
import { featured, finalPositions, loadEvent } from '../../../lib/event-page';
import { roundStory } from '../../../lib/event';
import { canonicalSearch, dateRange, resultText, roundParam } from '../../../lib/event-view';
import { isUploaded } from '../../../lib/uploads';
import { eventCacheControl } from '../../../lib/event-view';
import { KEY_PARAMS } from '../../../lib/cache-key';
import { eventRedirect, gamePath, twicIssueUrl } from '../../../lib/games';

export const prerender = false;

// Missing rounds get the site's not-found page (404.astro), cached at the edge too: crawlers retry them and
// each costs a query. Not for HEAD, whose body is empty: GET and HEAD share one edge cache entry.
const notFound = async () => {
  const res = await Astro.rewrite('/404');
  if (Astro.request.method === 'GET') res.headers.set('Cache-Control', 'public, max-age=300, s-maxage=3600');
  return res;
};
// One URL per round: 'round-3' only (not 03, 3x, 3.0), and no parameters (the page reads none), so
// that no variant costs a full event query of its own.
const n = roundParam(Astro.params.n);
if (n === null) return notFound();
const fix = canonicalSearch(Astro.url.searchParams, [], KEY_PARAMS);
if (fix !== null) return new Response(null, { status: 301, headers: { Location: Astro.url.pathname, 'Cache-Control': 'public, max-age=86400, s-maxage=604800' } });
const data = await loadEvent(Astro.params.slug ?? '');
const round = data?.a.rounds.find((r) => r.n === n);
if (!data || !round) {
  const moved = !data ? await eventRedirect(Astro.params.slug ?? '') : null;
  if (moved) return new Response(null, { status: 301, headers: { Location: `/events/${moved}/round-${n}/`, 'Cache-Control': 'public, max-age=86400, s-maxage=604800' } });
  return notFound();
}
const { event, a } = data;
// Uploaded tournaments change while they run: cache them briefly. TWIC events that ended a few weeks
// ago don't change any more (late games are rare; the cache is purged by tag after imports): a month.
Astro.response.headers.set('Cache-Control', isUploaded(event.id) ? 'public, max-age=60, s-maxage=300' : eventCacheControl(event));
const base = `/events/${event.slug}/`;
const idx = a.rounds.indexOf(round);
const prev = a.rounds[idx - 1];
const next = a.rounds[idx + 1];
const ko = a.format === 'knockout' ? a.knockout?.find((k) => k.n === n) : undefined;
const teamKo = a.teams?.knockout?.find((k) => k.n === n);
const roundName = ko && a.format === 'knockout' ? ko.name : teamKo ? teamKo.name : a.format === 'match' ? `Game ${n}` : `Round ${n}`;
const individual = (a.format === 'round-robin' || a.format === 'swiss') && a.complete;
// Team standings mean little in a knockout; with most matches missing they are only these matches' scores.
const teamTable = a.teams && !a.teams.knockout;
const labelOf = (r: number) => (a.knockout ?? a.teams?.knockout)?.find((k) => k.n === r)?.name ?? `Round ${r}`;

// Standings before and after this round, and who moved.
const after = individual ? a.standingsAfter(n) : [];
const before = individual && prev ? a.standingsAfter(prev.n) : [];
const pointsBefore = individual ? new Map(a.players.size ? [...a.players.keys()].map((id) => [id, 0] as [number, number]) : []) : undefined;
for (const l of before) pointsBefore?.set(l.player.id, l.points);
const rankBefore = new Map(before.map((l) => [l.player.id, l.rank]));
const moves = new Map(after.filter((l) => rankBefore.has(l.player.id)).map((l) => [l.player.id, rankBefore.get(l.player.id)! - l.rank]));
const tAfter = a.teams?.standingsAfter(n) ?? [];
const tBeforeRank = new Map((a.teams && prev ? a.teams.standingsAfter(prev.n) : []).map((l) => [l.team, l.rank]));
const tMoves = new Map(tAfter.filter((l) => tBeforeRank.has(l.team)).map((l) => [l.team, tBeforeRank.get(l.team)! - l.rank]));
const tRank = new Map(tAfter.map((l) => [l.team, l.rank]));

const story = roundStory(a, n);
const boards = await finalPositions(featured(a, n));
const matches = a.teams?.matches.filter((m) => m.round === n) ?? [];
const title = `${event.name}, ${roundName.toLowerCase()}: results${individual || teamTable ? ' and standings' : ''}`;
const winnerOf = (r: string, w: string, b: string) => (r === '1-0' ? w : r === '0-1' ? b : null);
const abs = (p: string) => new URL(p, Astro.site ?? 'https://chessmoments.com').href;
const jsonLd = [
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Games', item: abs('/games/') },
      { '@type': 'ListItem', position: 2, name: 'Events', item: abs('/events/') },
      { '@type': 'ListItem', position: 3, name: event.name, item: abs(base) },
      { '@type': 'ListItem', position: 4, name: roundName },
    ],
  },
  {
    '@type': 'SportsEvent',
    '@id': abs(`${base}round-${n}/`),
    name: `${event.name}: ${roundName}`,
    sport: 'Chess',
    ...(round.first ? { startDate: round.first } : {}),
    ...(round.last ? { endDate: round.last } : {}),
    url: abs(`${base}round-${n}/`),
    superEvent: { '@type': 'SportsEvent', '@id': abs(base), name: event.name, url: abs(base) },
  },
];
---

<Layout
  og={{ fen: boards[0]?.fen ?? START_FEN, lastMove: boards[0]?.last, kicker: `${event.name} · ${roundName}`, title: story[story.length - 1] ?? `${event.name}: ${roundName}`, subtitle: story.length > 1 ? story[0] : dateRange(round.first, round.last), footer: dateRange(round.first, round.last) }}
  title={title} description={`${event.name} ${roundName.toLowerCase()} (${dateRange(round.first, round.last)}): ${story.join(' ')}`} wide jsonLd={jsonLd}>
  <nav class="crumbs"><a href="/games/">Games</a> › <a href="/events/">Events</a> › <a href={base}>{event.name}</a></nav>
  <h1>{event.name}: {roundName}</h1>
  <p class="ev-facts">
    <span><strong>{dateRange(round.first, round.last)}</strong></span>
    {event.site && <span>{event.site}</span>}
    <span>{a.teams ? `${matches.length} matches` : `${round.games.length} games`}</span>
  </p>

  <nav class="ev-roundnav" aria-label="Rounds">
    {a.rounds.map((r) => (r.n === n ? <span class="current" aria-current="page">{r.n}</span> : <a href={`${base}round-${r.n}/`}>{r.n}</a>))}
  </nav>

  {story.length > 0 && <div class="ev-story">{story.map((s) => <p>{s}</p>)}</div>}
  {a.thinRounds.includes(n) && (
    <p class="ev-note">Only {round.games.length} games of this round are in the database (a full round has about {Math.max(...a.rounds.map((r) => r.games.length))}): the scores count the games there are, so they may differ from the official standings.</p>
  )}
  {a.teams?.partial && <p class="ev-note">Only some of this event’s matches are in the database: the scores below count those matches, so they are not the official standings.</p>}

  {boards.length > 0 && (
    <section>
      <h2>Key games</h2>
      <div class="ev-featured">
        {boards.map(({ game: g, fen, last }) => {
          const w = winnerOf(g.result, g.white_name, g.black_name);
          return (
            <figure>
              <a href={gamePath(g)}>
                <BoardDiagram fen={fen} highlight={last} flip={g.result === '0-1'} title={`Final position: ${g.white_name} – ${g.black_name}`} />
                <figcaption>
                  {g.white_name} – {g.black_name} <span class="res">{resultText(g.result)}</span><br />
                  <span class="ev-muted">{w ? `${w} won` : 'Draw'} in {Math.ceil(g.plies / 2)} moves{g.opening_name && ` · ${g.opening_name.split(':')[0]}`}</span>
                </figcaption>
              </a>
            </figure>
          );
        })}
      </div>
    </section>
  )}

  {a.teams && (
    <section>
      <h2>Matches</h2>
      <div class="ev-matches">{matches.map((m) => <TeamMatch m={m} boards={a.teams!.boards} />)}</div>
      {teamTable && (
        <>
          <h2>{a.teams!.partial ? `Scores in these matches after ${roundName.toLowerCase()}` : `Standings after ${roundName.toLowerCase()}`}</h2>
          <TeamStandings lines={tAfter} rankOf={tRank} moves={tMoves} base={base} limit={40} sb={!a.teams!.partial} />
          {tAfter.length > 40 && <p><a href={base}>Full standings</a></p>}
        </>
      )}
    </section>
  )}

  {ko && (
    <section>
      <h2>{a.format === 'match' ? 'The match' : 'Matches'}</h2>
      <Knockout round={ko} />
    </section>
  )}

  {!a.teams && !ko && (
    <section>
      <h2>Results</h2>
      <RoundGames games={round.games} players={a.players} before={individual ? pointsBefore : undefined} />
    </section>
  )}

  {individual && (
    <section>
      <h2>Standings after {roundName.toLowerCase()}</h2>
      <Standings lines={after} moves={prev ? moves : undefined} tiebreak={a.format === 'round-robin' ? 'sb' : 'buchholz'} limit={30} />
      {after.length > 30 && <p><a href={base}>Full standings</a></p>}
    </section>
  )}

  <nav class="ev-prevnext">
    {prev ? <a href={`${base}round-${prev.n}/`} rel="prev">← {labelOf(prev.n)}</a> : <a href={base}>← {event.name}</a>}
    {next ? (
      <a href={`${base}round-${next.n}/`} rel="next">{labelOf(next.n)} →</a>
    ) : (
      <a href={base}>{a.ongoing ? 'Standings' : a.format === 'round-robin' ? 'Final crosstable' : a.format === 'knockout' || a.teams?.knockout ? 'Bracket' : 'Final standings'} →</a>
    )}
  </nav>

  {isUploaded(event.id) && <p class="credit">Games uploaded by the tournament organiser.</p>}
  {event.twic && <p class="credit">Games from <a href={twicIssueUrl(event.twic)} rel="nofollow">The Week in Chess</a> by Mark Crowther, used with permission.</p>}
</Layout>

<style>
  .crumbs { font-size: 0.9rem; color: var(--muted); }
  .credit { margin-top: 2rem; font-size: 0.85rem; color: var(--muted); }
</style>
