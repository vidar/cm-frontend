---
import Layout from '../../layouts/Layout.astro';
import { recentEvents } from '../../lib/games';

export const prerender = false;
Astro.response.headers.set('Cache-Control', 'public, max-age=3600, s-maxage=86400');
const events = await recentEvents(200);
---

<Layout title="Chess tournaments and events" description="Recent over-the-board chess tournaments with every game to replay.">
  <nav class="crumbs"><a href="/games/">Games</a></nav>
  <h1>Events</h1>
  <p class="organisers">Organising a tournament? <a href="/upload/">Upload its games</a> round by round.</p>
  <ul class="list">
    {events.map((e) => (
      <li><a href={`/events/${e.slug}/`}>{e.name}</a> <span class="muted">{e.site && `${e.site} · `}{e.start_date} · {e.games} games</span></li>
    ))}
  </ul>
</Layout>

<style>
  .organisers { color: var(--muted); font-size: 0.92rem; margin-top: -0.3rem; }
  .crumbs { font-size: 0.9rem; color: var(--muted); }
  .list { list-style: none; padding: 0; }
  .list li { padding: 0.3rem 0; border-bottom: 1px solid color-mix(in srgb, currentColor 12%, transparent); }
  .muted { color: var(--muted); font-size: 0.9em; }
</style>
