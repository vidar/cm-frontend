---
import Layout from '../../layouts/Layout.astro';
import { getOpenings, getFamilies, formatMoves } from '../../lib/openings';
import { getStats, sample } from '../../lib/opening-stats';

const total = getOpenings().length;
// Most played first: games reaching the family's main (shortest) line.
const families = getFamilies()
  .map((f) => ({ ...f, games: getStats(f.lines[0])?.n ?? 0 }))
  .sort((a, b) => b.games - a.games || a.name.localeCompare(b.name));
const share = (n: number) => {
  const p = (n / sample.gamesCounted) * 100;
  return p >= 1 ? `${Math.round(p)}%` : p >= 0.1 ? `${p.toFixed(1)}%` : '<0.1%';
};
---

<Layout
  title="Chess openings: every named line with moves and diagrams"
  description={`Browse ${total.toLocaleString('en')} named chess openings in ${families.length} families, each with moves, ECO code, FEN and a board diagram.`}
>
  <h1>Chess openings</h1>
  <p>
    {total.toLocaleString('en')} named opening lines in {families.length} families, each with its moves, ECO code, FEN and a board diagram.
    Sorted by how often they're played on Lichess. All data is also available as <a href="/openings.json">JSON</a>.
  </p>
  <label for="filter">Filter families</label>
  <input id="filter" type="search" placeholder="e.g. Sicilian, Gambit, Indian" autocomplete="off" />
  <ul class="families" id="families">
    {families.map((f) => (
      <li data-search={f.name.toLowerCase()}>
        <a href={`/openings/family/${f.slug}/`}>{f.name}</a>
        <span class="muted">{f.lines.length} {f.lines.length === 1 ? 'line' : 'lines'} · {formatMoves(f.lines[0].moves)}{f.games > 0 && ` · ${share(f.games)} of games`}</span>
      </li>
    ))}
  </ul>
</Layout>

<style>
  #filter { width: 100%; padding: 0.4rem; margin-bottom: 1rem; font: inherit; }
  .families { list-style: none; padding: 0; }
  .families li { padding: 0.3rem 0; border-bottom: 1px solid color-mix(in srgb, currentColor 12%, transparent); }
  .muted { color: var(--muted); font-size: 0.9em; margin-left: 0.4rem; }
</style>

<script>
  const input = document.getElementById('filter') as HTMLInputElement;
  const items = [...document.querySelectorAll<HTMLLIElement>('#families li')];
  input.addEventListener('input', () => {
    const q = input.value.trim().toLowerCase();
    for (const li of items) li.hidden = !!q && !li.dataset.search!.includes(q);
  });
</script>
