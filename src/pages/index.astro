---
import { getEntry, render } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import { TOOLS } from '../lib/tools';

const home = await getEntry('home', 'home');
if (!home) throw new Error('Missing homepage content: src/content/home.md');
const { Content } = await render(home);
// The games database's ways in, shown above the tools (which list the database once more for llms.txt).
const DATABASE = [
  { href: '/events/', name: 'Events', blurb: 'Tournaments round by round: standings, crosstables, key games and upsets. The latest finished events first.' },
  { href: '/players/', name: 'Players', blurb: 'Every player’s games and score, with filters for White and Black, from world champions to club players.' },
  { href: '/games/search/', name: 'Search games', blurb: 'Find games by player, event, opening, result, rating or date.' },
  { href: '/games/', name: 'Recent games', blurb: 'Millions of over-the-board games since 2012, the newest top games first.' },
];
const site = (Astro.site ?? new URL('https://chessmoments.com')).href;
const jsonLd = {
  '@type': 'WebSite',
  name: 'chessmoments',
  url: site,
  potentialAction: { '@type': 'SearchAction', target: { '@type': 'EntryPoint', urlTemplate: `${site}players/?q={search_term_string}` }, 'query-input': 'required name=search_term_string' },
};
---

<Layout title={home.data.title} description={home.data.description} jsonLd={jsonLd}>
  <h1>{home.data.heading}</h1>
  <Content />

  <!-- The games database first: it is what the site has that the tools don't. -->
  <section class="db" aria-labelledby="db-h">
    <h2 id="db-h">Games database</h2>
    <form class="find" action="/players/" method="get" role="search">
      <input type="search" name="q" placeholder="Find a player, e.g. Carlsen" aria-label="Player name" required />
      <button type="submit" class="primary">Find player</button>
    </form>
    <ul class="hubs">
      {DATABASE.map((d) => (
        <li>
          <a href={d.href}><strong>{d.name}</strong></a>
          <p>{d.blurb}</p>
        </li>
      ))}
    </ul>
  </section>

  <h2>Train, study and play</h2>
  <ul class="tools">
    {TOOLS.filter((t) => t.href !== '/games/').map((t) => (
      <li>
        <a href={t.href}><strong>{t.name}</strong></a>
        <p>{t.blurb}</p>
      </li>
    ))}
  </ul>
</Layout>

<style>
  .db h2, .db + h2 { margin-top: 2rem; }
  .find { display: flex; flex-wrap: wrap; gap: 0.5rem; margin: 0.75rem 0 1rem; max-width: 34rem; }
  .find input { flex: 1 1 14rem; }
  .hubs { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(10.5rem, 1fr)); gap: 0.75rem; }
  .hubs li { position: relative; background: var(--accent-soft); border: 1px solid color-mix(in srgb, var(--accent) 25%, var(--border)); border-radius: var(--radius); padding: 0.9rem 1rem 1rem; transition: border-color 0.15s, box-shadow 0.15s; }
  .hubs li:hover { border-color: var(--accent); box-shadow: var(--shadow); }
  .hubs a { color: var(--fg); text-decoration: none; font-family: var(--font-head); font-size: 1.15rem; font-weight: 500; }
  .hubs a::after { content: ''; position: absolute; inset: 0; }
  .hubs p { margin: 0.3rem 0 0; color: var(--muted); font-size: 0.9rem; line-height: 1.45; }
  .tools { list-style: none; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(14rem, 1fr)); gap: 1rem; margin-top: 0.75rem; }
  .tools li { position: relative; background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius); padding: 1rem 1.1rem 1.1rem; transition: border-color 0.15s, transform 0.15s, box-shadow 0.15s; }
  .tools li:hover { border-color: color-mix(in srgb, var(--accent) 55%, var(--border)); box-shadow: var(--shadow); transform: translateY(-1px); }
  .tools a { color: var(--fg); text-decoration: none; font-family: var(--font-head); font-size: 1.15rem; font-weight: 500; }
  .tools a::after { content: ''; position: absolute; inset: 0; }
  .tools a::before { content: '→'; float: right; color: var(--accent); font-family: var(--font-body); opacity: 0; transform: translateX(-4px); transition: opacity 0.15s, transform 0.15s; }
  .tools li:hover a::before { opacity: 1; transform: none; }
  .tools p { margin: 0.35rem 0 0; color: var(--muted); font-size: 0.93rem; line-height: 1.5; }
</style>
