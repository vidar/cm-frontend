---
import { gamePath, resultLabel, scoreFor, type GameRow } from '../lib/games';

interface Props {
  games: GameRow[];
  /** Show the score from this player's point of view. */
  playerId?: number;
  showEvent?: boolean;
}
const { games, playerId, showEvent = true } = Astro.props;
const who = (name: string, title: string | null, elo: number | null) => `${title ? `${title} ` : ''}${name}${elo ? ` (${elo})` : ''}`;
---

<table class="games-table">
  <thead>
    <tr>
      <th>White</th><th>Black</th><th>Result</th>{showEvent && <th>Event</th>}<th>Date</th><th></th>
    </tr>
  </thead>
  <tbody>
    {games.map((g) => (
      <tr>
        <td class="w">{g.white_id === playerId ? <strong>{who(g.white_name, g.white_title, g.white_elo)}</strong> : <a href={`/players/${g.white_slug}/`}>{who(g.white_name, g.white_title, g.white_elo)}</a>}</td>
        <td class="b">{g.black_id === playerId ? <strong>{who(g.black_name, g.black_title, g.black_elo)}</strong> : <a href={`/players/${g.black_slug}/`}>{who(g.black_name, g.black_title, g.black_elo)}</a>}</td>
        <td class="res">{playerId ? scoreFor(g, playerId) : resultLabel(g.result)}</td>
        {showEvent && <td class="ev"><a href={`/events/${g.event_slug}/`}>{g.event_name}</a>{g.round && <span class="muted"> · R{g.round}</span>}</td>}
        <td class="date">{g.date}</td>
        <td class="view"><a href={gamePath(g)}>View</a></td>
      </tr>
    ))}
  </tbody>
</table>

<style>
  .games-table { width: 100%; border-collapse: collapse; font-size: 0.92rem; }
  .games-table th, .games-table td { text-align: left; padding: 0.4rem 0.6rem 0.4rem 0; border-bottom: 1px solid var(--border); vertical-align: top; }
  .games-table .res { font-variant-numeric: tabular-nums; white-space: nowrap; font-weight: 600; }
  .games-table .date { white-space: nowrap; color: var(--muted); }
  .games-table .view a { color: var(--accent); }
  .muted { color: var(--muted); }
  @media (max-width: 40rem) {
    .games-table thead { display: none; }
    .games-table tr {
      display: grid;
      grid-template-columns: 1fr auto;
      column-gap: 0.75rem;
      padding: 0.55rem 0;
      border-bottom: 1px solid var(--border);
    }
    .games-table td { border: 0; padding: 0; }
    .games-table .w { grid-column: 1; grid-row: 1; }
    .games-table .b { grid-column: 1; grid-row: 2; }
    .games-table .res { grid-column: 2; grid-row: 1 / span 2; align-self: center; font-size: 1.05rem; }
    .games-table .ev { grid-column: 1; grid-row: 3; font-size: 0.82rem; color: var(--muted); }
    .games-table .date { grid-column: 1; grid-row: 4; font-size: 0.82rem; }
    .games-table .view { grid-column: 2; grid-row: 3 / span 2; align-self: end; font-size: 0.85rem; }
  }
</style>
