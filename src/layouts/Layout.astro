---
import { getCollection } from 'astro:content';

interface Props {
  title: string;
  description?: string;
  /** Wider main column (e.g. the analysis board). */
  wide?: boolean;
}

const SITE_NAME = 'chessmoments';
const { title, description = 'Daily chess puzzles, opening explorer and free chess tools.', wide = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const path = Astro.url.pathname.replace(/\/?$/, '/');

// Menu is driven by the "Show in menu" and "Menu order" fields in the CMS.
const menuPages = (await getCollection('pages', ({ data }) => data.showInMenu)).sort(
  (a, b) => a.data.menuOrder - b.data.menuOrder || a.data.title.localeCompare(b.data.title),
);
const links = [
  { href: '/', label: 'Home' },
  { href: '/puzzle/', label: 'Daily puzzle' },
  { href: '/openings/', label: 'Openings' },
  { href: '/analysis/', label: 'Analysis' },
  { href: '/games/', label: 'Games' },
  { href: '/chess-clock/', label: 'Clock' },
  { href: '/coordinates-trainer/', label: 'Coordinates' },
  { href: '/board-image/', label: 'Board image' },
  ...menuPages.map((page) => ({ href: `/${page.id}/`, label: page.data.title })),
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="canonical" href={canonical} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    <meta name="generator" content={Astro.generator} />
    <title>{`${title} | ${SITE_NAME}`}</title>
  </head>
  <body>
    <header>
      <nav>
        {
          links.map(({ href, label }) => (
            <a href={href} aria-current={path === href || (href !== '/' && path.startsWith(href)) ? 'page' : undefined}>
              {label}
            </a>
          ))
        }
      </nav>
    </header>
    <main class:list={{ wide }}>
      <slot />
    </main>
    <footer>
      <p>
        &copy; {new Date().getFullYear()} {SITE_NAME} · <a href="/credits/">Credits</a> · <a href="/llms.txt">llms.txt</a>
      </p>
    </footer>
    <!-- Cloudflare Web Analytics. Automatic injection doesn't reach Worker-served assets, so it's
    added manually; beacons from other hostnames (previews, dev) are rejected by Cloudflare. -->
    <script
      is:inline
      type="module"
      src="https://static.cloudflareinsights.com/beacon.min.js"
      data-cf-beacon='{"token": "ee0b49e2b84b4e4b95f420090a14dd33"}'></script>
  </body>
</html>

<style is:global>
  :root {
    color-scheme: light dark;
    --fg: #111827;
    --bg: #ffffff;
    --muted: #6b7280;
    --accent: #f38020;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --fg: #f3f4f6;
      --bg: #0b0f17;
      --muted: #9ca3af;
    }
  }
  * {
    box-sizing: border-box;
  }
  body {
    margin: 0;
    font-family: system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
    line-height: 1.6;
    color: var(--fg);
    background: var(--bg);
  }
  header,
  main,
  footer {
    max-width: 48rem;
    margin: 0 auto;
    padding: 1rem;
  }
  nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.25rem;
  }
  footer a {
    color: inherit;
  }
  nav a {
    color: var(--muted);
    text-decoration: none;
    font-weight: 500;
  }
  nav a:hover,
  nav a[aria-current='page'] {
    color: var(--accent);
  }
  main img {
    max-width: 100%;
    height: auto;
  }
  main.wide {
    max-width: 72rem;
  }
  footer {
    color: var(--muted);
    font-size: 0.875rem;
  }
</style>
