---
import { getCollection } from 'astro:content';
import { Font } from 'astro:assets';

interface Props {
  title: string;
  description?: string;
  /** Wider main column (e.g. the analysis board). */
  wide?: boolean;
}

const SITE_NAME = 'chessmoments';
const { title, description = 'Daily chess puzzles, opening explorer and free chess tools.', wide = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const path = Astro.url.pathname.replace(/\/?$/, '/');

// Menu is driven by the "Show in menu" and "Menu order" fields in the CMS.
const menuPages = (await getCollection('pages', ({ data }) => data.showInMenu)).sort(
  (a, b) => a.data.menuOrder - b.data.menuOrder || a.data.title.localeCompare(b.data.title),
);
// Navigation: the tools grouped by what you do with them; CMS pages follow as plain links.
const groups = [
  {
    label: 'Train',
    items: [
      { href: '/puzzle/', label: 'Daily puzzle', note: 'A new puzzle every day' },
      { href: '/puzzle/archive/', label: 'Puzzle archive', note: 'Every past daily puzzle' },
      { href: '/coordinates-trainer/', label: 'Coordinates trainer', note: 'Learn the squares in 30 seconds' },
    ],
  },
  {
    label: 'Study',
    items: [
      { href: '/openings/', label: 'Openings', note: 'Every named line with statistics' },
      { href: '/analysis/', label: 'Analysis board', note: 'Stockfish in your browser' },
    ],
  },
  {
    label: 'Games',
    items: [
      { href: '/games/', label: 'Games database', note: 'Millions of master games' },
      { href: '/players/', label: 'Players', note: 'Search any player' },
      { href: '/events/', label: 'Events', note: 'Tournaments, round by round' },
    ],
  },
  {
    label: 'Tools',
    items: [
      { href: '/chess-clock/', label: 'Chess clock', note: 'For over-the-board games' },
      { href: '/board-image/', label: 'Board image', note: 'Diagrams from FEN or PGN' },
    ],
  },
];
const isCurrent = (href: string) => path === href || (href !== '/' && path.startsWith(href));
// The most specific match wins (/puzzle/archive/ over /puzzle/).
const currentHref = groups
  .flatMap((g) => g.items.map((i) => i.href))
  .filter(isCurrent)
  .sort((a, b) => b.length - a.length)[0];
const pages = menuPages.map((page) => ({ href: `/${page.id}/`, label: page.data.title }));
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="canonical" href={canonical} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#fbfaf7" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#15120e" media="(prefers-color-scheme: dark)" />
    <Font cssVariable="--font-display" preload />
    <Font cssVariable="--font-text" preload />
    <title>{`${title} | ${SITE_NAME}`}</title>
  </head>
  <body>
    <header class:list={{ wide }}>
      <nav aria-label="Main">
        <a class="brand" href="/" aria-current={path === '/' ? 'page' : undefined}>{SITE_NAME}</a>
        <ul class="menu">
          {groups.map((g) => (
            <li>
              <details class="nav-group" data-current={g.items.some((i) => i.href === currentHref) ? '' : undefined}>
                <summary>{g.label}</summary>
                <ul class="nav-panel">
                  {g.items.map((i) => (
                    <li>
                      <a href={i.href} aria-current={i.href === currentHref ? 'page' : undefined}>
                        <span class="label">{i.label}</span>
                        <span class="note">{i.note}</span>
                      </a>
                    </li>
                  ))}
                </ul>
              </details>
            </li>
          ))}
          {pages.map((p) => (
            <li><a class="plain" href={p.href} aria-current={isCurrent(p.href) ? 'page' : undefined}>{p.label}</a></li>
          ))}
        </ul>
      </nav>
    </header>
    <script is:inline>
      // One menu open at a time; close on outside click or Escape.
      document.addEventListener('click', (e) => {
        for (const d of document.querySelectorAll('nav details[open]')) if (!d.contains(e.target)) d.open = false;
      });
      document.addEventListener('keydown', (e) => {
        if (e.key !== 'Escape') return;
        for (const d of document.querySelectorAll('nav details[open]')) {
          d.open = false;
          d.querySelector('summary').focus();
        }
      });
    </script>
    <main class:list={{ wide }}>
      <slot />
    </main>
    <footer class:list={{ wide }}>
      <p>
        &copy; {new Date().getFullYear()} {SITE_NAME} · <a href="/credits/">Credits</a> · <a href="/llms.txt">llms.txt</a>
      </p>
    </footer>
    <!-- Cloudflare Web Analytics. Automatic injection doesn't reach Worker-served assets, so it's
    added manually; beacons from other hostnames (previews, dev) are rejected by Cloudflare. -->
    <script
      is:inline
      type="module"
      src="https://static.cloudflareinsights.com/beacon.min.js"
      data-cf-beacon='{"token": "ee0b49e2b84b4e4b95f420090a14dd33"}'></script>
  </body>
</html>

<style is:global>
  /* Design tokens: warm paper / warm black, stone greys, amber used sparingly. */
  :root {
    color-scheme: light dark;
    --bg: #fbfaf7;
    --surface: #ffffff;
    --surface-2: #f4f1ea;
    --fg: #1c1917;
    --muted: #6f6a64;
    --border: #e7e1d6;
    --border-strong: #d6cdbd;
    --accent: #b45309; /* text-safe amber (links, active states) */
    --accent-fill: #b45309; /* filled controls, with white text */
    --accent-soft: #fbf0dc; /* tints */
    --win: #2f7d46;
    --loss: #b4382f;
    --shadow: 0 10px 30px rgba(60, 40, 10, 0.12);
    --radius: 8px;
    --font-body: var(--font-text), system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
    --font-head: var(--font-display), Georgia, serif;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #15120e;
      --surface: #1c1814;
      --surface-2: #26201a;
      --fg: #efe9df;
      --muted: #a39b90;
      --border: #332b22;
      --border-strong: #4a3f32;
      --accent: #e9a94b;
      --accent-fill: #b45309;
      --accent-soft: #2e2416;
      --win: #6cc28a;
      --loss: #ec8a7f;
      --shadow: 0 10px 30px rgba(0, 0, 0, 0.45);
    }
  }
  * {
    box-sizing: border-box;
  }
  body {
    margin: 0;
    font-family: var(--font-body);
    font-size: 1rem;
    line-height: 1.6;
    color: var(--fg);
    background: var(--bg);
    -webkit-font-smoothing: antialiased;
    font-feature-settings: 'cv11', 'ss01';
  }
  h1,
  h2,
  h3 {
    font-family: var(--font-head);
    font-weight: 600;
    line-height: 1.15;
    letter-spacing: -0.01em;
    font-variation-settings: 'SOFT' 50;
    text-wrap: balance;
  }
  h1 {
    font-size: clamp(1.9rem, 1.4rem + 2vw, 2.6rem);
    margin: 0.5rem 0 0.75rem;
  }
  h2,
  h3 {
    font-weight: 500;
  }
  h2 {
    font-size: 1.45rem;
    margin: 2rem 0 0.6rem;
  }
  h3 {
    font-size: 1.15rem;
  }
  a {
    color: var(--accent);
    text-decoration-line: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.18em;
    text-decoration-color: color-mix(in srgb, var(--accent) 35%, transparent);
  }
  a:hover {
    text-decoration-color: currentColor;
  }
  :focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
    border-radius: 3px;
  }
  ::selection {
    background: color-mix(in srgb, var(--accent) 28%, transparent);
  }
  code,
  kbd,
  pre {
    font-family: ui-monospace, 'SF Mono', Menlo, Consolas, monospace;
    font-size: 0.88em;
  }
  kbd {
    border: 1px solid var(--border-strong);
    border-bottom-width: 2px;
    border-radius: 4px;
    padding: 0 0.3em;
    background: var(--surface);
  }

  /* Form controls */
  :where(button, input, select, textarea) {
    font: inherit;
    color: inherit;
  }
  :where(button, .button) {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.35rem;
    padding: 0.4rem 0.9rem;
    border: 1px solid var(--border-strong);
    border-radius: 6px;
    background: var(--surface);
    color: var(--fg);
    cursor: pointer;
    line-height: 1.3;
    text-decoration: none;
    transition: border-color 0.15s, background-color 0.15s;
  }
  :where(button:hover:not(:disabled), .button:hover) {
    border-color: var(--accent);
    background: var(--accent-soft);
  }
  :where(button:disabled) {
    opacity: 0.5;
    cursor: default;
  }
  :where(button.primary, .button.primary) {
    background: var(--accent-fill);
    border-color: var(--accent-fill);
    color: #fff;
    font-weight: 600;
  }
  :where(button.primary:hover:not(:disabled), .button.primary:hover) {
    background: color-mix(in srgb, var(--accent-fill) 88%, #000);
    border-color: color-mix(in srgb, var(--accent-fill) 88%, #000);
  }
  :where(input:not([type='checkbox'], [type='radio'], [type='range']), select, textarea) {
    padding: 0.4rem 0.6rem;
    border: 1px solid var(--border-strong);
    border-radius: 6px;
    background: var(--surface);
    max-width: 100%;
  }
  :where(input:focus-visible, select:focus-visible, textarea:focus-visible) {
    outline: 2px solid color-mix(in srgb, var(--accent) 60%, transparent);
    outline-offset: 0;
    border-color: var(--accent);
  }
  :where(input[type='checkbox'], input[type='radio'], input[type='range']) {
    accent-color: var(--accent-fill);
  }
  details > summary {
    cursor: pointer;
  }
  table {
    font-variant-numeric: tabular-nums;
  }
  th {
    color: var(--muted);
    font-weight: 600;
  }
  /* Links inside tables, lists and breadcrumbs stay quiet; amber on hover. Links in running
     text keep the accent. */
  :where(td, main li, .crumbs) a:not(.ev-r) {
    color: var(--fg);
    text-decoration-color: var(--border-strong);
  }
  :where(td, main li, .crumbs) a:not(.ev-r):hover {
    color: var(--accent);
    text-decoration-color: currentColor;
  }
  .crumbs {
    font-size: 0.88rem;
    color: var(--muted);
  }
  .crumbs a {
    color: var(--muted) !important;
  }
  hr {
    border: 0;
    border-top: 1px solid var(--border);
  }

  /* Page frame */
  header,
  main,
  footer {
    max-width: 48rem;
    margin: 0 auto;
    padding: 1rem;
  }
  header {
    padding-top: 1.1rem;
    padding-bottom: 0.9rem;
  }
  main.wide,
  header.wide,
  footer.wide {
    max-width: 72rem;
  }
  main img {
    max-width: 100%;
    height: auto;
  }
  footer {
    margin-top: 3rem;
    border-top: 1px solid var(--border);
    color: var(--muted);
    font-size: 0.875rem;
  }
  footer a {
    color: inherit;
  }

  /* Navigation */
  nav {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.25rem 1.75rem;
    position: relative;
  }
  .brand {
    font-family: var(--font-head);
    font-size: 1.35rem;
    font-weight: 600;
    letter-spacing: -0.015em;
    color: var(--fg);
    text-decoration: none;
  }
  .brand::first-letter {
    color: var(--accent);
  }
  .menu {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.2rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .menu > li {
    position: relative;
  }
  .nav-group > summary,
  .menu .plain {
    color: var(--muted);
    font-weight: 500;
    text-decoration: none;
    list-style: none;
  }
  .nav-group > summary::-webkit-details-marker {
    display: none;
  }
  .nav-group > summary::after {
    content: '';
    display: inline-block;
    margin-left: 0.35rem;
    border: 0.25rem solid transparent;
    border-top-color: currentColor;
    border-bottom-width: 0;
    vertical-align: 0.15rem;
    opacity: 0.7;
  }
  .nav-group[open] > summary::after {
    transform: rotate(180deg);
  }
  .nav-group > summary:hover,
  .nav-group[open] > summary,
  .menu .plain:hover,
  .brand:hover {
    color: var(--fg);
  }
  .nav-group[data-current] > summary,
  .menu .plain[aria-current='page'] {
    color: var(--fg);
    text-decoration: underline;
    text-decoration-color: var(--accent);
    text-decoration-thickness: 2px;
    text-underline-offset: 0.45em;
  }
  .nav-panel {
    position: absolute;
    top: calc(100% + 0.5rem);
    left: -0.75rem;
    z-index: 20;
    min-width: 16rem;
    list-style: none;
    margin: 0;
    padding: 0.35rem;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
  }
  .nav-panel a {
    display: block;
    padding: 0.45rem 0.65rem;
    border-radius: 6px;
    text-decoration: none;
    color: var(--fg);
    line-height: 1.3;
  }
  .nav-panel a:hover,
  .nav-panel a:focus-visible {
    background: var(--accent-soft);
  }
  .nav-panel a[aria-current='page'] .label {
    color: var(--accent);
  }
  .nav-panel .label {
    display: block;
    font-weight: 600;
  }
  .nav-panel .note {
    display: block;
    font-size: 0.8rem;
    color: var(--muted);
  }
  @media (max-width: 30rem) {
    nav {
      gap: 0.4rem 1rem;
    }
    .menu > li {
      position: static;
    }
    .nav-panel {
      left: 0;
      right: 0;
    }
  }
</style>
